{
  "info": {
    "name": "Healthcare API Tests",
    "description": "Lab 5 Postman collection (DEVOPS healthcare API). Base URL: http://localhost:3000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /api/doctors",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array\", function () {",
              "  pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/doctors",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "doctors"
          ]
        }
      }
    },
    {
      "name": "POST /api/doctors",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response has an id\", function () {",
              "  pm.expect(pm.response.json()).to.have.property(\"id\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/doctors",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "doctors"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Julie\",\n  \"specialty\": \"Neurology\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
