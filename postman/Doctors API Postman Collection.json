    {
      "name": "Add doctor",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {\r",
              "  pm.response.to.have.status(201)\r",
              "})\r",
              "\r",
              "pm.test('Doctor was created correctly', function () {\r",
              "  const doctor = pm.response.json()\r",
              "\r",
              "  pm.expect(doctor.id).to.be.a('number')\r",
              "  pm.expect(doctor.name).to.equal('Dr. Julie')\r",
              "  pm.expect(doctor.specialty).to.equal('Neurology')\r",
              "})"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"Dr. Julie\",\r\n  \"specialty\": \"Neurology\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/api/doctors",
          "protocol": "http",
          "host": [
